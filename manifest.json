{
  "manifest_version": 3,
  "name": "ヒヨリ 日程入力アシスト",
  "short_name": "ヒヨリ日程入力",
  "version": "1.0.0",
  "key": "",
  "description": "伝助・デイコード・調整さん・ヒヨリの入力画面に、フリカレ／Googleカレンダー／テキストからの取り込みやまとめて入力を追加します。カレンダーの予定はどこにも送りません。",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://freecalend.com/open/data",
    "https://calendar.google.com/calendar/ical/*",
    "https://macchan.onrender.com/api/sched/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://densuke.biz/*",
        "http://densuke.biz/*",
        "https://www.densuke.biz/*",
        "https://character-sheets.appspot.com/schedule/input*",
        "https://chouseisan.com/s*"
      ],
      "js": [
        "availability.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://densuke.biz/event*",
        "https://www.densuke.biz/event*"
      ],
      "js": [
        "availability.js",
        "create.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://macchan.onrender.com/sched/*"
      ],
      "js": [
        "availability.js",
        "hiyori.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://macchan.onrender.com/sched/",
  "action": {
    "default_title": "ヒヨリを開く",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
