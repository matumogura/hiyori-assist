{
  "manifest_version": 3,
  "name": "ヒヨリ 日程入力アシスト",
  "short_name": "ヒヨリ日程入力",
  "version": "0.8.2",
  "key": "",
  "description": "伝助・デイコード・調整さんの出欠入力画面に「フリカレから取り込む」「テキストから取り込む」「まとめて入力」「いつものコメント」を追加します。",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://freecalend.com/open/data",
    "https://calendar.google.com/calendar/ical/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://densuke.biz/*",
        "http://densuke.biz/*",
        "https://character-sheets.appspot.com/schedule/input*",
        "https://chouseisan.com/s*"
      ],
      "js": [
        "availability.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://macchan.onrender.com/sched/",
  "action": {
    "default_title": "ヒヨリを開く",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  }
}